#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Structure Lock Pre-Commit Hook
# Validates that no locked files are being modified

echo "🔍 Checking structure lock compliance..."

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo "✅ No files to validate"
    exit 0
fi

# Run structure validator
node structure-validator.js $STAGED_FILES

VALIDATION_RESULT=$?

if [ $VALIDATION_RESULT -ne 0 ]; then
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "🚫 COMMIT BLOCKED: Structure lock violation detected"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "You attempted to modify locked platform structure files."
    echo ""
    echo "📖 See STRUCTURE_LOCK.md for:"
    echo "   • What files are locked"
    echo "   • What files you CAN modify"
    echo "   • Override process (if absolutely necessary)"
    echo ""
    echo "💡 Focus on content files:"
    echo "   • *-agent*.js (agent logic)"
    echo "   • educational-content.js (questions/content)"
    echo "   • st6co-demo-data*.js (demo data)"
    echo "   • recommendations-library.js (recommendations)"
    echo ""
    exit 1
fi

echo "✅ Structure lock compliance verified"
exit 0